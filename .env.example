# ============================================================
# EYECAP INDIA — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and provide your deployment secrets.
# NEVER commit real credentials to version control.
# ============================================================

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-your-database.region.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="generate_a_secure_minimum_32_character_random_secret_here"
JWT_EXPIRES_IN="7d"

# Default Administration Bootstrap Credentials (Used during initial setup only)
ADMIN_NAME="EYECAP Security Admin"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="replace_with_strong_password_minimum_16_characters"

# Delivery Partner Bootstrap Credentials
DELIVERY_NAME="Alex Vance"
DELIVERY_EMAIL="courier@yourdomain.com"
DELIVERY_PASSWORD="replace_with_strong_password_minimum_12_characters"
DELIVERY_PHONE="+1 (555) 019-2834"

# Customer Bootstrap Credentials
CUSTOMER_NAME="Dhiman Roy"
CUSTOMER_EMAIL="customer@yourdomain.com"
CUSTOMER_PASSWORD="replace_with_strong_password_minimum_12_characters"

# Public Application Settings
NEXT_PUBLIC_APP_URL="https://eyecapindia.netlify.app"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"

# 3D Studio & Asset Pipeline (Optional / Local generation)
EYECAP_PYTHON="python"

# S3-Compatible Object Storage for 3D/GLB Assets (Optional)
# S3_ENDPOINT="https://s3.region.amazonaws.com"
# S3_BUCKET_NAME="eyecap-assets"
# S3_ACCESS_KEY_ID="your_access_key"
# S3_SECRET_ACCESS_KEY="your_secret_key"
# S3_REGION="auto"
