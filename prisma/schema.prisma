generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  role                 String                 @default("CUSTOMER")
  firstName            String
  lastName             String
  phone                String?
  avatarUrl            String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  addresses            Address[]
  adminProfile         AdminProfile?
  auditLogs            AuditLog[]
  cart                 Cart?
  customerProfile      CustomerProfile?
  deliveryPartner      DeliveryPartner?
  notifications        Notification[]
  orders               Order[]
  ProductUnit          ProductUnit[]
  reviews              Review[]
  SupportMessage       SupportMessage[]
  SupportStatusHistory SupportStatusHistory[]
  SupportTicket        SupportTicket[]
  wishlistItems        Wishlist[]
}

model CustomerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  loyaltyPoints     Int      @default(100)
  prescriptionType  String?
  odSphere          Float?
  osSphere          Float?
  pupillaryDistance Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  department   String   @default("Executive Operations")
  isSuperAdmin Boolean  @default(false)
  accessLevel  Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryPartner {
  id              String     @id @default(uuid())
  userId          String     @unique
  vehicleType     String     @default("Motorcycle")
  vehiclePlate    String     @default("EYE-2026-X")
  isAvailable     Boolean    @default(true)
  currentZone     String     @default("Metropolitan Downtown")
  rating          Float      @default(4.9)
  totalDeliveries Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deliveries      Delivery[]
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  bannerImage  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  headline        String?
  description     String
  basePrice       Float
  comparePrice    Float?
  sku             String              @unique
  modelNumber     String              @unique
  brand           String?
  discountPercent Float               @default(0)
  gsm             Int?
  specifications  String              @default("{}")
  tags            String              @default("[]")
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  categoryId      String
  isFeatured      Boolean             @default(false)
  isNew           Boolean             @default(false)
  isPublished     Boolean             @default(true)
  frameShape      String              @default("Geometric")
  frameMaterial   String              @default("Grade 5 Titanium")
  lensMaterial    String              @default("Polycarbonate UV400 Polarized")
  lensWidthMm     Int                 @default(53)
  bridgeWidthMm   Int                 @default(18)
  templeLengthMm  Int                 @default(145)
  totalWeightG    Int                 @default(18)
  genderStyle     String              @default("Unisex")
  rating          Float               @default(4.8)
  reviewCount     Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  releaseDate     DateTime?
  cartItems       CartItem[]
  inventory       Inventory?
  orderItems      OrderItem[]
  category        Category            @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  model3d         ProductModel3D?
  modelAssets     ProductModelAsset[]
  productVideos   ProductVideo[]
  glassLinks      ProductGlass[]
  couponProducts  CouponProduct[]
  ProductUnit     ProductUnit[]
  variants        ProductVariant[]
  reviews         Review[]
  wishlistItems   Wishlist[]
}

model ProductVariant {
  id              String        @id @default(uuid())
  productId       String
  name            String
  colorName       String
  colorHex        String
  size            String        @default("Standard")
  sku             String        @unique
  priceAdjustment Float         @default(0.0)
  imageUrl        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cartItems       CartItem[]
  inventory       Inventory?
  orderItems      OrderItem[]
  ProductUnit     ProductUnit[]
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String
  url          String
  alt          String?
  displayOrder Int     @default(0)
  isPrimary    Boolean @default(false)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  posterUrl    String?
  title        String?
  displayOrder Int      @default(0)
  isBackground Boolean  @default(true)
  autoplay     Boolean  @default(true)
  loop         Boolean  @default(true)
  muted        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, displayOrder])
}

model GlassOption {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  description     String?
  material        String?
  priceAdjustment Float          @default(0)
  isActive        Boolean        @default(true)
  displayOrder    Int            @default(0)
  products        ProductGlass[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductGlass {
  id            String      @id @default(uuid())
  productId     String
  glassId       String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  glass         GlassOption @relation(fields: [glassId], references: [id], onDelete: Cascade)
  isDefault     Boolean     @default(false)
  priceOverride Float?
  createdAt     DateTime    @default(now())

  @@unique([productId, glassId])
  @@index([productId])
  @@index([glassId])
}

model ProductModel3D {
  id           String             @id @default(uuid())
  productId    String             @unique
  assetId      String?            @unique
  modelUrl     String?
  posterUrl    String
  modelType    String             @default("titanium_sleek")
  lensColor    String             @default("#1E293B")
  frameColor   String             @default("#383B42")
  metalness    Float              @default(0.85)
  roughness    Float              @default(0.20)
  transmission Float              @default(0.60)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  asset        ProductModelAsset? @relation(fields: [assetId], references: [id])
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductModelAsset {
  id            String          @id @default(uuid())
  productId     String
  name          String
  version       Int
  status        String          @default("DRAFT")
  modelKey      String          @unique
  sourceKey     String?
  modelSize     Int
  sourceSize    Int?
  triangleCount Int?
  textureCount  Int             @default(0)
  format        String          @default("GLB")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  model3d       ProductModel3D?
  product       Product         @relation(fields: [productId], references: [id])

  @@unique([productId, version])
  @@index([productId, status])
}

model Inventory {
  id                String          @id @default(uuid())
  productId         String          @unique
  variantId         String?         @unique
  available         Int             @default(50)
  reserved          Int             @default(0)
  sold              Int             @default(0)
  lowStockThreshold Int             @default(10)
  updatedAt         DateTime        @updatedAt
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  unitPrice Float
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  fullName   String
  phone      String
  street     String
  apartment  String?
  city       String
  state      String
  postalCode String
  country    String   @default("United States")
  isDefault  Boolean  @default(false)
  type       String   @default("HOME")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  userId          String
  addressId       String?
  status          String          @default("ORDER_PLACED")
  paymentStatus   String          @default("PENDING")
  paymentMethod   String          @default("ONLINE")
  subtotal        Float
  discount        Float           @default(0.0)
  tax             Float           @default(0.0)
  shippingFee     Float           @default(0.0)
  total           Float
  couponCode      String?
  notes           String?
  deliveryOtp     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  delivery        Delivery?
  shippingAddress Address?        @relation(fields: [addressId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  payments        Payment[]
  ProductUnit     ProductUnit[]
  SupportTicket   SupportTicket[]
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String
  variantId          String?
  productName        String
  variantName        String?
  colorHex           String?
  sku                String
  unitPrice          Float
  quantity           Int
  totalPrice         Float
  leftSphere         Float?
  leftCylinder       Float?
  leftAxis           Int?
  rightSphere        Float?
  rightCylinder      Float?
  rightAxis          Int?
  pupillaryDistance  Float?
  glassConfiguration String          @default("{}")
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  ProductUnit        ProductUnit[]
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  transactionId String   @unique
  provider      String
  amount        Float
  currency      String   @default("USD")
  status        String   @default("SUCCESS")
  rawResponse   String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Delivery {
  id               String           @id @default(uuid())
  orderId          String           @unique
  partnerId        String?
  status           String           @default("UNASSIGNED")
  assignedAt       DateTime?
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failedReason     String?
  customerOtp      String
  otpVerified      Boolean          @default(false)
  otpVerifiedAt    DateTime?
  proofImageUrl    String?
  recipientName    String?
  partnerNotes     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  trackingNumber   String?          @unique
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner          DeliveryPartner? @relation(fields: [partnerId], references: [id])
}

model Coupon {
  id                   String          @id @default(uuid())
  code                 String          @unique
  description          String?
  discountType         String          @default("PERCENT")
  discountValue        Float
  minOrderValue        Float           @default(0.0)
  maxDiscount          Float?
  validFrom            DateTime        @default(now())
  validUntil           DateTime?
  usageLimit           Int?
  usageCount           Int             @default(0)
  isActive             Boolean         @default(true)
  appliesToAllProducts Boolean         @default(true)
  products             CouponProduct[]
  createdAt            DateTime        @default(now())
}

model CouponProduct {
  id        String  @id @default(uuid())
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([couponId])
  @@index([productId])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int      @default(5)
  title              String
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
}

model SiteSettings {
  id              String   @id @default("primary")
  siteName        String   @default("EYECAP")
  defaultTitle    String   @default("EYECAP — Premium Eyewear")
  titleTemplate   String   @default("%page% | EYECAP")
  description     String   @default("Architectural eyewear engineered with precision optics.")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#22d3ee")
  accentColor     String   @default("#d4af37")
  backgroundColor String   @default("#08090c")
  socialLinks     String   @default("{}")
  updatedAt       DateTime @updatedAt
}

model HomepageSection {
  id           String   @id @default(uuid())
  key          String   @unique
  title        String
  subtitle     String?
  body         String?
  imageUrl     String?
  ctaText      String?
  ctaUrl       String?
  background   String?
  animation    String   @default("none")
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Post {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  subtitle    String?
  description String
  coverImage  String?
  gallery     String    @default("[]")
  type        String    @default("ANNOUNCEMENT")
  status      String    @default("DRAFT")
  animation   String    @default("none")
  isFeatured  Boolean   @default(false)
  priority    Int       @default(0)
  publishedAt DateTime?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Popup {
  id               String    @id @default(uuid())
  title            String
  description      String?
  imageUrl         String?
  ctaText          String?
  destinationUrl   String?
  displayFrequency String    @default("once")
  deviceTarget     String    @default("all")
  status           String    @default("DRAFT")
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model GraphicsConfig {
  id            String             @id @default("primary")
  draftJson     String             @default("{}")
  publishedJson String             @default("{}")
  version       Int                @default(1)
  updatedAt     DateTime           @updatedAt
  revisions     GraphicsRevision[]
}

model GraphicsRevision {
  id         String         @id @default(uuid())
  configId   String
  version    Int
  configJson String
  createdAt  DateTime       @default(now())
  config     GraphicsConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, version])
  @@index([configId, createdAt])
}

model ProductUnit {
  id             String          @id
  trackingNumber String          @unique
  serialNumber   String          @unique
  productId      String
  variantId      String?
  ownerId        String?
  orderId        String?
  orderItemId    String?
  manufacturedAt DateTime?
  purchasedAt    DateTime?
  deliveredAt    DateTime?
  warrantyUntil  DateTime?
  status         String          @default("AVAILABLE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  Order          Order?          @relation(fields: [orderId], references: [id])
  OrderItem      OrderItem?      @relation(fields: [orderItemId], references: [id])
  User           User?           @relation(fields: [ownerId], references: [id])
  Product        Product         @relation(fields: [productId], references: [id])
  ProductVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([ownerId])
  @@index([productId])
  @@index([status])
  @@index([variantId])
}

model SupportAttachment {
  id             String          @id
  ticketId       String
  messageId      String?
  fileUrl        String
  fileName       String
  fileType       String?
  fileSize       Int?
  createdAt      DateTime        @default(now())
  SupportMessage SupportMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  SupportTicket  SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([ticketId])
}

model SupportMessage {
  id                String               @id
  ticketId          String
  senderId          String?
  senderType        SupportMessageSender
  message           String
  createdAt         DateTime             @default(now())
  SupportAttachment SupportAttachment[]
  User              User?                @relation(fields: [senderId], references: [id])
  SupportTicket     SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([senderId])
  @@index([ticketId])
}

model SupportStatusHistory {
  id            String               @id
  ticketId      String
  changedById   String?
  fromStatus    SupportTicketStatus?
  toStatus      SupportTicketStatus
  note          String?
  createdAt     DateTime             @default(now())
  User          User?                @relation(fields: [changedById], references: [id])
  SupportTicket SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([changedById])
  @@index([createdAt])
  @@index([ticketId])
}

model SupportTicket {
  id                   String                 @id
  ticketNumber         String                 @unique
  userId               String
  orderId              String?
  subject              String
  issueType            String
  description          String
  status               SupportTicketStatus    @default(OPEN)
  priority             SupportPriority        @default(NORMAL)
  resolution           String?
  rejectionReason      String?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  SupportAttachment    SupportAttachment[]
  SupportMessage       SupportMessage[]
  SupportStatusHistory SupportStatusHistory[]
  Order                Order?                 @relation(fields: [orderId], references: [id])
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orderId])
  @@index([status])
  @@index([userId])
}

enum SupportMessageSender {
  USER
  ADMIN
  SYSTEM
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}
